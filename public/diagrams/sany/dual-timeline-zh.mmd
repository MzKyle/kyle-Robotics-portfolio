    SEP --> SWING["周期摆弧分量"]
    SLOW --> MODEL["局部运动模型估计"]
    SWING --> MODEL
    MODEL --> PHASE["关键摆弧相位检测"]
    PHASE --> TP["t_phase / t_peak"]
  end
  SYNC["统一时间基准"]
